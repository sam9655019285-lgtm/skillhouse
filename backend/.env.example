# Copy this file to .env and fill in real values. Never commit .env.
# Every variable here is read by backend/services — see README.md
# "Phase 13" section for what each one does and which are optional.

# ---- Server ----
PORT=3000
# Any http://localhost:* or http://127.0.0.1:* origin is allowed
# automatically in development (NODE_ENV != production) — this covers
# Live Server, python -m http.server, etc. regardless of which port
# they pick. Add extra comma-separated origins here only if you need
# something beyond localhost (e.g. deploying the frontend elsewhere),
# and set NODE_ENV=production to stop auto-allowing all localhost origins.
CORS_ORIGIN=

# ---- Mode ----
# true  -> always use MockProvider (bundled demo/sample data), regardless
#          of whether the variables below are filled in.
# false -> use the real providers below; falls back to mock automatically
#          if a provider is unconfigured, unapproved, or fails.
DEMO_MODE=true

# ---- LinkedIn (official LinkedIn APIs only — see linkedinService.js) ----
# Leave blank until you have an approved LinkedIn API product. With
# these blank, linkedinProvider reports "LinkedIn integration not
# approved" and the system automatically falls back to another
# configured provider.
# NOTE: there is no LINKEDIN_ACCESS_TOKEN here anymore — the access
# token is no longer a single app-wide secret. Each user connects
# their own LinkedIn account via GET /api/linkedin/connect (OAuth
# redirect flow, routes/linkedin.js) and their token is persisted per
# user in SQLite (backend/data/app.db), never in .env.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
LINKEDIN_SCOPE=openid profile email

# ---- Frontend origin (where the browser app is served from) ----
# Used to redirect back to api-status.html after the LinkedIn OAuth
# callback, and should also be listed in CORS_ORIGIN if it isn't a
# localhost/127.0.0.1 origin.
FRONTEND_URL=http://127.0.0.1:5500

# ---- Sessions ----
# How many days a login session (and its HTTP-only cookie) stays valid.
SESSION_TTL_DAYS=7

# ---- SQLite database file path (users, sessions, LinkedIn tokens) ----
# Defaults to backend/data/app.db — change only if you need it elsewhere.
DB_PATH=

# ---- Job Market API (no key required — see providers/jobMarketProvider.js) ----
# A public, keyless job-listings API used as the "other legally
# available data source" when LinkedIn isn't approved. Leave as-is
# unless you're pointing this at a different provider.
JOB_MARKET_API_BASE_URL=https://remotive.com/api/remote-jobs

# ---- Freshness thresholds (minutes) — see services/dataNormalizer.js ----
FRESHNESS_LIVE_MINUTES=10
FRESHNESS_RECENT_MINUTES=60

# ---- Cache ----
CACHE_TTL_MINUTES=5

# ---- Auto-refresh (frontend polling interval, minutes) ----
REFRESH_INTERVAL_MINUTES=5

# ---- Environment ----
# "production" disables verbose/debug error detail in API responses.
NODE_ENV=development

# ---- AI Assistant (floating chatbot, see backend/services/assistantService.js) ----
# Optional. Leave blank and the assistant still works fully, using its
# built-in FAQ/job-matching logic (backend/data/assistantFaq.json,
# assistantKnowledge.json) instead of an external model. Set this to an
# Anthropic API key only to have Claude phrase answers more naturally
# and handle open-ended general questions that aren't in the built-in
# knowledge base. Never put this key in any frontend file.
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=claude-haiku-4-5-20251001
